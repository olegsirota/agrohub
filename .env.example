# Доступы к рекламным кабинетам для scripts/ads/ads.mjs
# Скопируйте в .env (он в .gitignore) и заполните. Инструкция: scripts/ads/README.md

# Яндекс Директ — OAuth-токен с правом direct:api
YANDEX_DIRECT_TOKEN=
# Только для агентского токена: логин клиента
# YANDEX_DIRECT_CLIENT_LOGIN=
# Песочница вместо боевого API
# YANDEX_DIRECT_SANDBOX=1

# VK Реклама (ads.vk.com) — Настройки → Доступ по API
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=
# Для агентского доступа: id клиента
# VK_ADS_AGENCY_CLIENT_ID=
# Либо готовый токен вместо client_id/secret
# VK_ADS_TOKEN=
